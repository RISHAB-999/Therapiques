# Copy to .env and fill in. Never commit real values.
NODE_ENV=production
PORT=4000
MONGO_URI=

# Long random value (>= 32 chars), e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=
JWT_EXPIRES_IN=7d
ADMIN_JWT_EXPIRES_IN=12h
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Exact frontend origins, comma separated (e.g. https://therapique.vercel.app,https://therapique-admin.vercel.app)
CORS_ORIGINS=
# Number of reverse proxies in front of the API (Render = 1)
TRUST_PROXY=1

CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
CURRENCY=INR

BREVO_API_KEY=
BREVO_SENDER_EMAIL=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SENDER_EMAIL=
GEMINI_API_KEY=
